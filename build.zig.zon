.{
    .name = .translate_c,

    .version = "0.0.0",

    .fingerprint = 0x1c84f6455a54f043, // Changing this has security and trust implications.

    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // A vendored fork of https://github.com/vancluever/arocc (commit
        // f97cdfc3779aec4b242299e2fc9a1c828c3547c6) with Objective-C related
        // patches; see deps/aro/PATCHES.md.
        .aro = .{
            .path = "deps/aro",
        },
    },

    .paths = .{
        "build",
        "deps",
        "build.zig",
        "build.zig.zon",
        "src",
        "lib",
        "test/cases.zig",
        "LICENSE",
        "README.md",
    },
}
